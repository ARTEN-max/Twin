{
  "expo": {
    "name": "Twin",
    "slug": "twin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.twin.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Twin needs microphone access to record conversations for transcription and AI debriefs.",
        "NSSpeechRecognitionUsageDescription": "Twin uses speech recognition to help transcribe recordings. Audio may also be securely processed on Twin's servers to complete transcription and generate debriefs.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "ai.twin.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "93a39f3c-bb57-469c-af3e-d87bf9c017f0"
      },
      "EXPO_PUBLIC_API_BASE_URL": "https://twin-production-a0e4.up.railway.app",
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyDODEUf0TgWMszRv1EH_VMK9wtdFwEd9CE",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "twin-cdd01.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "twin-cdd01",
      "EXPO_PUBLIC_FIREBASE_APP_ID": "1:1034213917033:web:b0e425b4fcdee4e986fdf8",
      "EXPO_PUBLIC_PRIVACY_POLICY_URL": "",
      "EXPO_PUBLIC_TERMS_URL": "",
      "EXPO_PUBLIC_SUPPORT_EMAIL": ""
    },
    "owner": "arlnu"
  }
}
